<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.alapierre.ksef-sdk</groupId>
    <artifactId>KSeF-sdk</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>KSeF SDK</name>
    <description>Fork of MF/AK Java SDK for KSeF (Krajowy System e-Faktur)</description>
    <url>https://github.com/alapierre/ksef-client-java-mf-fork</url>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Adrian Lapierre</name>
            <email>al@alapierre.io</email>
        </developer>
        <developer>
            <name>Karol Bryzgiel</name>
            <email>karol.bryzgiel@itrust.dev</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/alapierre/ksef-client-java-mf-fork.git</connection>
        <developerConnection>scm:git:ssh://github.com:alapierre/ksef-client-java-mf-fork.git</developerConnection>
        <url>https://github.com/alapierre/ksef-client-java-mf-fork</url>
    </scm>

    <modules>
        <module>ksef-client</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        
        <!-- Dependency versions -->
        <bouncycastle.version>1.82</bouncycastle.version>
        <jackson.version>2.17.1</jackson.version>
        <junit.version>4.13.2</junit.version>
        <junit-vintage.version>5.8.2</junit-vintage.version>
        <jaxb.version>4.0.6</jaxb.version>
        <jaxb-fluent-api.version>3.0</jaxb-fluent-api.version>
        <dss.version>6.0.1</dss.version>
        <zxing.version>3.5.3</zxing.version>
        <lombok.version>1.18.42</lombok.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <httpclient.version>4.5.14</httpclient.version>
        <slf4j.version>2.0.13</slf4j.version>
    </properties>

</project>
